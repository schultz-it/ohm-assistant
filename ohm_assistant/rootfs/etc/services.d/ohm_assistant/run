#!/usr/bin/with-contenv bashio
bashio::log.info "Starting Ohm Assistant..."
export LOG_LEVEL=$(bashio::config 'log_level')
export AI_PROVIDER=$(bashio::config 'ai_provider')
export AI_API_KEY=$(bashio::config 'ai_api_key')
export AI_MODEL=$(bashio::config 'ai_model')
# Mostrata nell'intestazione della UI: serve a vedere subito quale versione
# sta davvero girando dopo un aggiornamento.
export ADDON_VERSION=$(bashio::addon.version)
bashio::log.info "Version ${ADDON_VERSION}"
cd /app
exec python3 -m uvicorn backend.main:app --host 0.0.0.0 --port 8099
